# TrynDraft Docker Compose Environment Configuration
# Copy this file to .env and fill in your actual values
# This file is used by docker-compose.yml

# ============================================
# SECURITY (REQUIRED FOR DOCKER)
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=generate-your-secret-key-with-openssl-rand-hex-32

# ============================================
# DATABASE CREDENTIALS
# ============================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate-strong-password-here

# ============================================
# REDIS CREDENTIALS
# ============================================
REDIS_PASSWORD=generate-strong-password-here

# ============================================
# API KEYS
# ============================================
# HuggingFace token for LLM models
HF_TOKEN=your_huggingface_token_here

# Riot Games API key (optional)
RIOT_API_KEY=

# ============================================
# APPLICATION SETTINGS
# ============================================
DEBUG=False
CORS_ORIGINS=http://localhost:3000,http://frontend:80

# For production, update CORS_ORIGINS to your domain:
# CORS_ORIGINS=https://yourdomain.com
