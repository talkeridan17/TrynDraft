# TrynDraft Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# SECURITY (REQUIRED)
# ============================================
# Generate with: openssl rand -hex 32
SECRET_KEY=generate-your-secret-key-with-openssl-rand-hex-32

# ============================================
# DATABASE
# ============================================
# For local development (SQLite)
DATABASE_URL=sqlite:///./tryndraft.db

# For production (PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/tryndraft

# ============================================
# REDIS CACHE
# ============================================
REDIS_URL=redis://localhost:6379
# If Redis has password: redis://:password@localhost:6379

# ============================================
# API KEYS
# ============================================
# HuggingFace token for LLM models
HF_TOKEN=your_huggingface_token_here

# Riot Games API key (optional for enhanced features)
RIOT_API_KEY=

# ============================================
# APPLICATION SETTINGS
# ============================================
DEBUG=True
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ============================================
# DATA CACHING
# ============================================
CACHE_DURATION_HOURS=6
